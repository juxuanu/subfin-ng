root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{csproj,props,targets,json,html,xml,yml,yaml}]
indent_size = 2

[*.{sln,py}]
indent_size = 4

# Rider writes these itself, with tabs
[*.DotSettings]
indent_style = tab

[*.cs]
indent_size = 4

# ── Code style ───────────────────────────────────────────────────────────────

# var for every local
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Target-typed new() where the type is evident. Where it isn't, either form: new() for the JSON
# dictionaries handed to SubsonicEnvelope.Ok, the explicit type for query and DTO objects.
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
resharper_object_creation_when_type_evident = target_typed
resharper_arrange_object_creation_when_type_not_evident_highlighting = none

# Collection expressions for literal collections, but LINQ chains end in .ToList()/.ToArray()
# rather than [.. query] (the second part is Rider-only, in subfin-plugin.sln.DotSettings)
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_diagnostic.IDE0305.severity = none

# Multi-line SQL stays in verbatim strings
resharper_use_raw_string_highlighting = none

# A trailing comma after the last item of multi-line lists and initializers, none on one line
resharper_trailing_comma_in_multiline_lists = true
resharper_trailing_comma_in_singleline_lists = false

# ── Naming ───────────────────────────────────────────────────────────────────
# Rider's defaults, pinned so every editor (and `dotnet format`) checks the same thing:
#   types, methods, properties, events, local functions   PascalCase
#   interfaces / type parameters                           IPascalCase / TPascalCase
#   constants and static readonly fields                   PascalCase
#   other private fields                                   _camelCase
#   non-private fields                                     PascalCase
#   parameters, locals and local constants                 camelCase
# Rules apply most specific first (modifiers, then accessibility, then kind), not in file order.

# Command-line tools ignore the per-rule severities below and only report naming with this set
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I

dotnet_naming_style.t_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_pascal_case.required_prefix = T

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = i_pascal_case
dotnet_naming_rule.interfaces.severity = warning

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_rule.type_parameters.symbols = type_parameters
dotnet_naming_rule.type_parameters.style = t_pascal_case
dotnet_naming_rule.type_parameters.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, delegate, method, property, event, local_function
dotnet_naming_rule.types_and_members.symbols = types_and_members
dotnet_naming_rule.types_and_members.style = pascal_case
dotnet_naming_rule.types_and_members.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal_case
dotnet_naming_rule.constants.severity = warning

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_fields.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields.style = pascal_case
dotnet_naming_rule.static_readonly_fields.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel_case
dotnet_naming_rule.private_fields.severity = warning

dotnet_naming_symbols.non_private_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_rule.non_private_fields.symbols = non_private_fields
dotnet_naming_rule.non_private_fields.style = pascal_case
dotnet_naming_rule.non_private_fields.severity = warning

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local
dotnet_naming_rule.parameters_and_locals.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals.style = camel_case
dotnet_naming_rule.parameters_and_locals.severity = warning
